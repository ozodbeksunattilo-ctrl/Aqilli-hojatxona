# ---------------------------------------------------------------------------
# Smart Restroom — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Web app (public values, safe for the browser) -------------------------
# Leave both empty to run the self-contained LOCAL DEMO (no backend needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Usernames are mapped to <username>@<domain> for Supabase Auth.
VITE_AUTH_EMAIL_DOMAIN=smartrestroom.local
# Force the local demo even when Supabase is configured.
# VITE_LOCAL_DEMO=true

# --- Server-only (scripts/bootstrap.ts) — NEVER expose to the browser --------
SUPABASE_SERVICE_ROLE_KEY=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_EMPLOYEES=asqar:Asqar Karimov,bekzod:Bekzod Aliyev,dilnoza:Dilnoza Rahimova

# --- Turnstile simulator (pnpm simulate) — demo/testing only -----------------
# Tokens come from Admin → Devices → Rotate token (or pnpm bootstrap).
SIM_TOKEN_MEN_001=
SIM_TOKEN_WOMEN_001=

# ---------------------------------------------------------------------------
# Edge Function secrets are NOT read from this file. Set them in Supabase:
#   supabase secrets set TELEGRAM_BOT_TOKEN=... TELEGRAM_WEBHOOK_SECRET=... \
#     DISPATCH_SECRET=... TELEGRAM_ADMIN_IDS=123456789 AUTH_EMAIL_DOMAIN=smartrestroom.local
# ---------------------------------------------------------------------------
